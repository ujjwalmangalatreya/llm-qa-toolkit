# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so your keys never leave your machine.

# --- Required ---

# Google Gemini API key — get one for free at https://aistudio.google.com/apikey
# The free tier covers all dev + CI for this toolkit at typical volumes.
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---

# Default Gemini model for text generation. Override per-test if needed.
# Free-tier friendly choices: gemini-2.5-flash, gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash

# Default Gemini embedding model. Used by the toBeSemanticallySimilar matcher.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Default similarity threshold for toBeSemanticallySimilar (0.0 - 1.0).
SIMILARITY_THRESHOLD=0.75

# DocsBot URL — points at the system under test in later phases.
# Leave unset while you're only testing the Gemini API directly.
DOCSBOT_URL=http://localhost:3000
